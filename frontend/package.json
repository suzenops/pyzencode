{
  "name": "pyzencode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:python": "node scripts/prepare-python.mjs",
    "predev": "npm run prepare:python",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:python",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests scripts *.ts *.json public/python-worker.js index.html"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.14",
    "@uiw/react-codemirror": "^4.25.2",
    "lucide-react": "^0.468.0",
    "pyodide": "0.27.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
